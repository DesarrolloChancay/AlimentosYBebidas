# Archivo: .env.example
# Copia este archivo como .env y configura tus valores locales

# Entorno de ejecución (development/production)
FLASK_ENV=development

# Clave secreta para sesiones de Flask
SECRET_KEY=tu_clave_secreta_muy_segura_aqui

# Configuración de la API de encuestas
ENCUESTAS_API_URL=http://127.0.0.1:8000/api/v1
ENCUESTAS_API_TOKEN=tu_token_de_la_api_de_encuestas
# Override opcional (vacío = match por nombre vía GET /surveys?status=active)
# ENCUESTAS_SURVEY_MAP=silvia:3
ENCUESTAS_SURVEY_MAP=
ENCUESTAS_TIMEOUT_SECONDS=15

# Configuración de base de datos MySQL
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contraseña_mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alimentosybebidas

# Base de datos Postgres para usuarios Encargado / Jefe de Establecimiento
# (roles sin código de colaborador RRHH, usan cod_usuario propio tipo CC0001)
ENCARGADOS_DB_USER=tu_usuario_postgres
ENCARGADOS_DB_PASSWORD=tu_contraseña_postgres
ENCARGADOS_DB_HOST=localhost
ENCARGADOS_DB_PORT=5432
ENCARGADOS_DB_NAME=ayb_encargados

# API de RRHH: GET {RRHH_API_URL}/{dni} con header X-API-KEY
# Solo se consulta al crear/refrescar cuentas de Administrador, Inspector y
# Ayudante de Inspector (roles con código de colaborador en RRHH).
# Ejemplo: http://rrhh.local/api/external/workers
RRHH_API_URL=
RRHH_API_TOKEN=
RRHH_API_TIMEOUT_SECONDS=8

# Ajustes recomendados para producción detrás de Nginx
TRUST_PROXY_COUNT=1
PREFERRED_URL_SCHEME=https
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
MAX_CONTENT_LENGTH_MB=25
PRIVATE_UPLOAD_ROOT=

# Restringir Socket.IO al origen real del sistema.
# Ejemplo: https://ayb.clubcastillodechancay.com
SOCKETIO_CORS_ALLOWED_ORIGINS=

# Solo usar si en el futuro escalas Socket.IO con Redis y múltiples nodos
SOCKETIO_MESSAGE_QUEUE=
